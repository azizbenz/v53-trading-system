# V5.3 Trading System — Variables d'environnement
# Copier vers .env et remplir les valeurs

# Profil actif: light ou complete
V53_PROFILE=light

# Exchange
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Limites
MAX_NOTIONAL_USDT=1000
MAX_PAIRS_LIGHT=6
MAX_PAIRS_COMPLETE=12
