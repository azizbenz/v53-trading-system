# V5.3 Trading System - Variables d'environnement
# Copier ce fichier vers .env a la racine du repo.
# Le launcher unique scripts/Run-V53LocalSolution.ps1 lit ce fichier local.

# Profil actif: light ou complete
V53_PROFILE=light

# Exchange
BINANCE_API_KEY=replace_with_your_binance_api_key
BINANCE_API_SECRET=replace_with_your_binance_api_secret
BINANCE_TESTNET=true

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Limites
MAX_NOTIONAL_USDT=1000
MAX_PAIRS_LIGHT=6
MAX_PAIRS_COMPLETE=12
